# Copy to .env at the repository root. Never commit real keys.
FLASHKART_AUTH_MODE=clerk
VITE_AUTH_MODE=clerk
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
FLASHKART_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Set this after the intended owner registers. Use the immutable Clerk user ID.
FLASHKART_OWNER_USER_ID=
