# Documentation only. make dev-init generates .env with random local passwords.
APP_ENV=development
RUN_ID=local
POSTGRES_PORT=15432
KAFKA_PORT=19092
POSTGRES_ADMIN_PASSWORD=
ADMISSION_DB_PASSWORD=
FLASH_SALE_DB_PASSWORD=
ORDER_DB_PASSWORD=
ADMISSION_DATABASE_URL=
FLASH_SALE_DATABASE_URL=
ORDER_DATABASE_URL=
KAFKA_BROKERS=localhost:19092
ADMISSION_LISTEN_ADDR=127.0.0.1:8081
FLASH_SALE_LISTEN_ADDR=127.0.0.1:8082
ORDER_LISTEN_ADDR=127.0.0.1:8083
ANALYTICS_LISTEN_ADDR=127.0.0.1:8084
GATEWAY_LISTEN_ADDR=127.0.0.1:8080
ADMISSION_URL=http://127.0.0.1:8081
FLASH_SALE_URL=http://127.0.0.1:8082
ORDER_URL=http://127.0.0.1:8083
# Peer adapter inputs only; no peer implementation is started by Phase 1.
CATALOG_URL=http://127.0.0.1:8090
NOTIFICATION_URL=http://127.0.0.1:8091
INVENTORY_GRPC_ADDRESS=127.0.0.1:8092
JWT_PRIVATE_KEY_FILE=.secrets/local/jwt-private.pem
JWT_PUBLIC_KEY_FILE=.secrets/local/jwt-public.pem
SEEDED_TOKENS_FILE=.secrets/local/tokens.json
ANALYTICS_STATE_DIR=.cache/analytics
SHUTDOWN_TIMEOUT=5s

# Phase 2 local foundation mode; this does not satisfy E1/E2 acceptance.
DEV_PEER_MODE=fixture
ANALYTICS_URL=http://127.0.0.1:8084
GATEWAY_URL=http://127.0.0.1:8080
JWT_ISSUER=flashkart-local
JWT_AUDIENCE=flashkart
APP_REVISION=development

# Phase 3 private authoritative offer listener; Order mTLS identity only.
FLASH_SALE_INTERNAL_LISTEN_ADDR=127.0.0.1:8442
FLASH_SALE_INTERNAL_URL=https://127.0.0.1:8442

# Phase 4 mTLS purchase listeners; public gateway exposes only allowlisted routes.
ADMISSION_INTERNAL_LISTEN_ADDR=127.0.0.1:8441
ADMISSION_INTERNAL_URL=https://127.0.0.1:8441
ORDER_INTERNAL_LISTEN_ADDR=127.0.0.1:8443
ORDER_INTERNAL_URL=https://127.0.0.1:8443
