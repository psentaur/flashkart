# Copy to the ignored repository-root .env.cloud. This is trusted Bash syntax.
AWS_ACCOUNT_ID=REPLACE_WITH_12_DIGIT_ACCOUNT_ID
AWS_REGION=ap-south-1
ARTIFACT_NAME=flashkart-artifacts
FLASHKART_CLOUD_NAME=flashkart-demo
EKS_VERSION=REPLACE_WITH_SUPPORTED_EKS_VERSION
# Optional RDS capacity workaround; leaves existing compute/network AZs unchanged.
# DATABASE_AVAILABILITY_ZONE=ap-south-1c
OPERATOR_CIDRS='["REPLACE_WITH_YOUR_PUBLIC_IP/32"]'
IMAGE_TAG=REPLACE_WITH_IMMUTABLE_GIT_REVISION
# Leave empty to build backend images first; add the production key to include the frontend.
VITE_CLERK_PUBLISHABLE_KEY=''
# FLASHKART_IMAGE_SCOPE=backend  # Optional explicit backend-only build
# Optional: select existing shared bootstrap resources or an existing state key.
# STATE_BUCKET=your-existing-state-bucket
# ARTIFACT_REPOSITORY=123456789012.dkr.ecr.ap-south-1.amazonaws.com/flashkart-artifacts
# STATE_KEY=flashkart/demo.tfstate
# AWS_PROFILE=your-profile
# CONTAINER_ENGINE=podman
