{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flashkart purchase work v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "sale_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "occurred_at",
    "sale_id",
    "attempt_id",
    "customer_id"
  ]
}
