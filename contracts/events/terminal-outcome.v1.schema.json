{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flashkart terminal outcome v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "const": "attempt.terminal"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "sale_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "REJECTED",
            "CONFIRMED",
            "CANCELLED"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "order_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "state"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "occurred_at",
    "trace_id",
    "sale_id",
    "attempt_id",
    "customer_id",
    "payload"
  ]
}
