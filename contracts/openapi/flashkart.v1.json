  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_ARGUMENT",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CATALOG_CONFLICT",
              "IDEMPOTENCY_CONFLICT",
              "SALE_IMMUTABLE",
              "RATE_LIMITED",
              "QUORUM_UNAVAILABLE",
              "WRITE_OUTCOME_UNKNOWN",
              "NOT_IMPLEMENTED",
              "UNAVAILABLE",
              "INTERNAL"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "correlation_id": {
            "type": "string",
            "minLength": 1
          },
          "siblings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductVersion"
            }
          },
          "context": {
            "$ref": "#/components/schemas/CausalContext"
          }
        },
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "correlation_id"
        ]
      },
      "CausalContext": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "first": {
                "type": "string",
                "minLength": 1
              },
              "last": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "first",
              "last"
            ]
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "image_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false,
        "required": [
          "product_id",
          "name"
        ]
      },
      "ProductVersion": {
        "type": "object",
        "properties": {
          "product": {
            "$ref": "#/components/schemas/Product"
          },
          "replica_id": {
            "type": "string",
            "minLength": 1
          },
          "counter": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "product",
          "replica_id",
          "counter"
        ]
      },
      "ProductView": {
        "type": "object",
        "properties": {
          "product": {
            "$ref": "#/components/schemas/Product"
          },
          "context": {
            "$ref": "#/components/schemas/CausalContext"
          }
        },
        "additionalProperties": false,
        "required": [
          "product",
          "context"
        ]
      },
      "ProductWrite": {
        "type": "object",
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "product": {
            "$ref": "#/components/schemas/Product"
          },
          "context": {
            "$ref": "#/components/schemas/CausalContext"
          }
        },
        "additionalProperties": false,
        "required": [
          "operation_id",
          "product",
          "context"
        ]
      },
      "SaleTerms": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1
          },
          "price_minor": {
