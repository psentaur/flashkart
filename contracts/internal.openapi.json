{
  "openapi": "3.1.0",
  "info": {
    "title": "Flash Sale Internal REST Contract",
    "version": "1.0.0-draft.2"
  },
  "servers": [
    {
      "url": "https://order.internal"
    }
  ],
  "security": [
    {
      "serviceIdentity": []
    }
  ],
  "paths": {
    "/internal/orders": {
      "post": {
        "operationId": "acceptAdmittedPurchase",
        "description": "Admission only; verified shopper and attempt identity. Fetch normalized offer/cap, reserve through Inventory, and persist pending order/payment intent only after a durable hold. Propagate PURCHASE_LIMIT_EXCEEDED as a stable 409 with no payment.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "attempt_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "shopper_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "purchase": {
                    "$ref": "#/components/schemas/Purchase"
                  }
                },
                "required": [
                  "attempt_id",
                  "shopper_id",
                  "purchase"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Durable pending order and reservation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "200": {
            "description": "Terminal replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or absent identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Role denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Durable business conflict including PURCHASE_LIMIT_EXCEEDED, or retryable REQUEST_IN_PROGRESS.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Temporary dependency/quorum unavailability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Whole seconds before retry",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "/internal/offers/{sale_id}": {
      "get": {
        "operationId": "getAuthoritativeOffer",
        "description": "Flash Sale owner. Order identity only; never read Catalog as the charging authority.",
        "parameters": [
          {
            "name": "sale_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative current offer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Offer"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or absent identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Role denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Missing or not owned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Temporary dependency/quorum unavailability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Whole seconds before retry",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "/internal/notifications": {
      "get": {
        "operationId": "queryNotificationsLocally",
        "description": "Local/serverless query adapter contract. Member 3 chooses the invocation transport/platform; it must authenticate the gateway and filter by verified shopper subject.",
        "parameters": [
          {
            "name": "X-Shopper-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Subject-filtered notification page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Notice"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "items",
                    "next_cursor"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or absent identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Role denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Temporary dependency/quorum unavailability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Whole seconds before retry",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "/internal/analytics/windows": {
      "get": {
        "operationId": "getAnalyticsWindowSchedule",
        "description": "Analytics identity only. Flash Sale lists known sale/product minute windows in the requested interval, including zero-activity windows; the emitter skips finalized keys using its recovered View.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          },
          {
            "name": "through",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Known windows for the bounded demonstration dataset",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "windows",
                    "as_of"
                  ],
                  "properties": {
                    "windows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "sale_id",
                          "product_id",
                          "window_start",
                          "window_end"
                        ],
                        "properties": {
                          "sale_id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "product_id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "window_start": {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "Z$"
                          },
                          "window_end": {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "Z$"
                          }
                        }
                      }
                    },
                    "as_of": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "Z$"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid interval"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Analytics identity required"
          },
          "503": {
            "description": "Schedule temporarily unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceIdentity": {
        "type": "mutualTLS"
      }
    },
    "schemas": {
      "Offer": {
        "type": "object",
        "properties": {
          "sale_id": {
            "type": "string",
            "format": "uuid"
          },
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price_minor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "status": {
            "type": "string",
            "enum": [
              "UPCOMING",
              "ACTIVE",
              "ENDED",
              "UNAVAILABLE",
              "CANCELLED"
            ]
          },
          "per_shopper_unit_cap": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Cumulative unexpired held plus confirmed units allowed per shopper in this sale; frozen at sale start."
          }
        },
        "required": [
          "sale_id",
          "product_id",
          "version",
          "unit_price_minor",
          "currency",
          "starts_at",
          "ends_at",
          "status",
          "per_shopper_unit_cap"
        ],
        "additionalProperties": false
      },
      "SaleWrite": {
        "type": "object",
        "properties": {
          "sale_id": {
            "type": "string",
            "format": "uuid"
          },
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0
          },
          "unit_price_minor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "allocated_units": {
            "type": "integer",
            "minimum": 1
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "admission_limits": {
            "type": "object",
            "properties": {
              "shopper_per_second": {
                "type": "integer",
                "minimum": 1
              },
              "sale_per_second": {
                "type": "integer",
                "minimum": 1
              },
              "max_in_flight": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "shopper_per_second",
              "sale_per_second",
              "max_in_flight"
            ],
            "additionalProperties": false
          },
          "per_shopper_unit_cap": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Cumulative unexpired held plus confirmed units allowed per shopper in this sale; frozen at sale start. Omission normalizes to one on creation and replacement.",
            "default": 1
          }
        },
        "required": [
          "sale_id",
          "product_id",
          "expected_version",
          "unit_price_minor",
          "currency",
          "allocated_units",
          "starts_at",
          "ends_at",
          "admission_limits"
        ],
        "additionalProperties": false
      },
      "Sale": {
        "type": "object",
        "properties": {
          "sale_id": {
            "type": "string",
            "format": "uuid"
          },
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price_minor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "status": {
            "type": "string",
            "enum": [
              "UPCOMING",
              "ACTIVE",
              "ENDED",
              "UNAVAILABLE",
              "CANCELLED"
            ]
          },
          "allocated_units": {
            "type": "integer",
            "minimum": 1
          },
          "admission_limits": {
            "type": "object",
            "properties": {
              "shopper_per_second": {
                "type": "integer",
                "minimum": 1
              },
              "sale_per_second": {
                "type": "integer",
                "minimum": 1
              },
              "max_in_flight": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "shopper_per_second",
              "sale_per_second",
              "max_in_flight"
            ],
            "additionalProperties": false
          },
          "ready_participants": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "catalog",
                "admission",
                "inventory"
              ]
            },
            "uniqueItems": true
          },
          "per_shopper_unit_cap": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Cumulative unexpired held plus confirmed units allowed per shopper in this sale; frozen at sale start."
          }
        },
        "required": [
          "sale_id",
          "product_id",
          "version",
          "unit_price_minor",
          "currency",
          "starts_at",
          "ends_at",
          "status",
          "allocated_units",
          "admission_limits",
          "ready_participants",
          "per_shopper_unit_cap"
        ],
        "additionalProperties": false
      },
      "Purchase": {
        "type": "object",
        "properties": {
          "sale_id": {
            "type": "string",
            "format": "uuid"
          },
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "expected_offer_version": {
            "type": "integer",
            "minimum": 1
          },
          "expected_unit_price_minor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "required": [
          "sale_id",
          "product_id",
          "quantity",
          "expected_offer_version",
          "expected_unit_price_minor",
          "currency"
        ],
        "additionalProperties": false
      },
      "Order": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "format": "uuid"
          },
          "shopper_id": {
            "type": "string",
            "format": "uuid"
          },
          "sale_id": {
            "type": "string",
            "format": "uuid"
          },
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "reservation_id": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offer_version": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "total_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "PENDING_PAYMENT",
              "CONFIRMED",
              "FAILED",
              "EXPIRED"
            ]
          },
          "refund_status": {
            "type": "string",
            "enum": [
              "NONE",
              "PENDING",
              "COMPLETED",
              "REPAIR_REQUIRED"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "order_id",
          "shopper_id",
          "sale_id",
          "product_id",
          "reservation_id",
          "quantity",
          "offer_version",
          "unit_price_minor",
          "total_minor",
          "currency",
          "state",
          "refund_status",
          "expires_at",
          "created_at",
          "updated_at",
          "version"
        ],
        "additionalProperties": false
      },
      "Notice": {
        "type": "object",
        "properties": {
          "notice_id": {
            "type": "string",
            "format": "uuid"
          },
          "shopper_id": {
            "type": "string",
            "format": "uuid"
          },
          "order_id": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "FAILED",
              "EXPIRED",
              "REFUND_PENDING",
              "REFUND_COMPLETED"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "delivery_state": {
            "type": "string",
            "enum": [
              "PENDING",
              "DELIVERED",
              "REPAIR_REQUIRED"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "notice_id",
          "shopper_id",
          "order_id",
          "outcome",
          "message",
          "delivery_state",
          "created_at"
        ],
        "additionalProperties": false
      },
      "WindowSummary": {
        "type": "object",
        "properties": {
          "summary_id": {
            "type": "string",
            "format": "uuid"
          },
          "sale_id": {
            "type": "string",
            "format": "uuid"
          },
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "window_start": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "window_end": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PROVISIONAL",
              "FINAL"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "distinct_shoppers": {
            "type": "integer",
            "minimum": 0
          },
          "admitted": {
            "type": "integer",
            "minimum": 0
          },
          "rejected": {
            "type": "integer",
            "minimum": 0
          },
          "rejection_counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "payment_successes": {
            "type": "integer",
            "minimum": 0
          },
          "payment_failures": {
            "type": "integer",
            "minimum": 0
          },
          "confirmed_units": {
            "type": "integer",
            "minimum": 0
          },
          "revenue_by_currency": {
            "type": "object",
            "patternProperties": {
              "^[A-Z]{3}$": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          },
          "latency_buckets_ms": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 8,
            "maxItems": 8
          },
          "latency_count": {
            "type": "integer",
            "minimum": 0
          },
          "computed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "summary_id",
          "sale_id",
          "product_id",
          "window_start",
          "window_end",
          "revision",
          "status",
          "attempts",
          "distinct_shoppers",
          "admitted",
          "rejected",
          "rejection_counts",
          "payment_successes",
          "payment_failures",
          "confirmed_units",
          "revenue_by_currency",
          "latency_buckets_ms",
          "latency_count",
          "computed_at"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_ARGUMENT",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "SALE_INACTIVE",
              "SALE_NOT_READY",
              "OFFER_CHANGED",
              "SOLD_OUT",
              "INSUFFICIENT_STOCK",
              "RATE_LIMITED",
              "OVERLOADED",
              "IDEMPOTENCY_CONFLICT",
              "REQUEST_IN_PROGRESS",
              "METADATA_CONFLICT",
              "QUORUM_UNAVAILABLE",
              "DEPENDENCY_UNAVAILABLE",
              "VERSION_CONFLICT",
              "SALE_WINDOW_CONFLICT",
              "PURCHASE_LIMIT_EXCEEDED"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid"
          },
          "retryable": {
            "type": "boolean"
          },
          "retry_after_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "current_offer": {
            "$ref": "#/components/schemas/Offer"
          }
        },
        "required": [
          "code",
          "message",
          "correlation_id",
          "retryable"
        ],
        "additionalProperties": false
      },
      "MetadataWrite": {
        "type": "object",
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "context": {
            "type": "object",
            "properties": {
              "node-a": {
                "type": "integer",
                "minimum": 0
              },
              "node-b": {
                "type": "integer",
                "minimum": 0
              },
              "node-c": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "value": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "maxLength": 10000
              },
              "image_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "maxItems": 10
              }
            },
            "required": [
              "name",
              "description",
              "image_refs"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "operation_id",
          "context",
          "value"
        ],
        "additionalProperties": false
      },
      "ReplicaHealth": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string",
            "enum": [
              "node-a",
              "node-b",
              "node-c"
            ]
          },
          "healthy": {
            "type": "boolean"
          },
          "last_seen_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "node_id",
          "healthy",
          "last_seen_at"
        ],
        "additionalProperties": false
      }
    }
  }
}
